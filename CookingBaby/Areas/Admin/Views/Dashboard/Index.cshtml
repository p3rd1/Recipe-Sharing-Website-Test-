@model CookingBaby.Areas.Admin.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Bảng Điều Khiển & Duyệt Bài (Admin)";
    ViewBag.IsAdminPage = true;
    ViewBag.ActiveTab = "Admin";
    var fallbackImage = Url.Content("~/Content/images/pancake.jpg");
}
<meta charset="utf-8" />

<div class="admin-dashboard-head admin-toolbar-top">
    <div>
        <div class="admin-kicker">ADMIN CONTROL PANEL</div>
        <h1 class="admin-dashboard-title">Bảng Điều Khiển Quản Trị & Duyệt Bài</h1>
        <p class="admin-dashboard-subtitle">Theo dõi thống kê số liệu động từ database và kiểm duyệt công thức trên Cooking Baby.</p>
    </div>
</div>

@if (TempData["AdminSuccess"] != null)
{
    <div class="admin-alert admin-alert-success">
        ✓ @TempData["AdminSuccess"]
    </div>
}
@if (TempData["AdminError"] != null)
{
    <div class="admin-alert admin-alert-error">
        ⚠️ @TempData["AdminError"]
    </div>
}

<!-- 1. Grid 6 Thẻ Thống Kê Tổng Quan -->
<div class="admin-stat-grid-6">
    <div class="admin-stat-card stat-visible">
        <div class="admin-stat-icon">✓</div>
        <div>
            <div class="admin-stat-label">Đã duyệt</div>
            <div class="admin-stat-number">@Model.VisibleCount</div>
            <div class="admin-stat-note">Đang công khai</div>
        </div>
    </div>

    <div class="admin-stat-card stat-pending">
        <div class="admin-stat-icon">⏳</div>
        <div>
            <div class="admin-stat-label">Chờ duyệt</div>
            <div class="admin-stat-number">@Model.PendingCount</div>
            <div class="admin-stat-note">Cần kiểm tra</div>
        </div>
    </div>

    <div class="admin-stat-card stat-hidden">
        <div class="admin-stat-icon">⊘</div>
        <div>
            <div class="admin-stat-label">Đã ẩn</div>
            <div class="admin-stat-number">@Model.HiddenCount</div>
            <div class="admin-stat-note">Tạm khóa bài</div>
        </div>
    </div>

    <div class="admin-stat-card stat-users">
        <div class="admin-stat-icon">👥</div>
        <div>
            <div class="admin-stat-label">Thành viên</div>
            <div class="admin-stat-number">@Model.TotalUsers</div>
            <div class="admin-stat-note">Người dùng</div>
        </div>
    </div>

    <div class="admin-stat-card stat-comments">
        <div class="admin-stat-icon">💬</div>
        <div>
            <div class="admin-stat-label">Bình luận</div>
            <div class="admin-stat-number">@Model.TotalComments</div>
            <div class="admin-stat-note">Lượt trao đổi</div>
        </div>
    </div>

    <div class="admin-stat-card stat-ratings">
        <div class="admin-stat-icon">⭐</div>
        <div>
            <div class="admin-stat-label">Đánh giá</div>
            <div class="admin-stat-number">@Model.TotalRatings</div>
            <div class="admin-stat-note">Số lượt chấm sao</div>
        </div>
    </div>
</div>

<!-- 2. Khung Biểu Đồ Trực Quan (Chart.js) -->
<div class="admin-charts-grid">
    <!-- Biểu đồ 1: Phân bố theo danh mục -->
    <div class="admin-chart-card">
        <div class="admin-chart-header">
            <h3 class="admin-chart-title">📊 Phân Bố Theo Danh Mục</h3>
            <span class="admin-chart-badge">Tất cả món</span>
        </div>
        <div class="admin-chart-canvas-box">
            <canvas id="categoryChart"
                    data-labels="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategoryChartLabels)"
                    data-values="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.CategoryChartData)"></canvas>
        </div>
    </div>

    <!-- Biểu đồ 2: Xu hướng đăng bài theo tháng -->
    <div class="admin-chart-card">
        <div class="admin-chart-header">
            <h3 class="admin-chart-title">📈 Xu Hướng Đăng Bài (6 Tháng Gần Nhất)</h3>
            <span class="admin-chart-badge">Số lượng món</span>
        </div>
        <div class="admin-chart-canvas-box">
            <canvas id="monthlyChart"
                    data-labels="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyChartLabels)"
                    data-values="@Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthlyChartData)"></canvas>
        </div>
    </div>
</div>

<!-- 3. Bảng Kiểm Duyệt Công Thức -->
<div class="admin-list-header">
    <div>
        <h2>Danh Sách Quản Lý Công Thức</h2>
        <p>Tổng cộng @Model.Recipes.Count công thức trong cơ sở dữ liệu</p>
    </div>
</div>

<div class="admin-recipe-table-wrap">
    <table class="admin-recipe-table">
        <thead>
            <tr>
                <th>Món ăn</th>
                <th>Danh mục</th>
                <th>Tác giả</th>
                <th>Ngày đăng</th>
                <th>Trạng thái</th>
                <th class="admin-action-col">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Recipes.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Chưa có công thức nào trong hệ thống.
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Recipes)
                {
                    string imagePath = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? fallbackImage
                        : (item.ImageUrl.StartsWith("/") || item.ImageUrl.StartsWith("~"))
                            ? Url.Content(item.ImageUrl)
                            : (item.ImageUrl.StartsWith("Uploads/"))
                                ? Url.Content("~/" + item.ImageUrl)
                                : Url.Content("~/Content/images/" + item.ImageUrl);
                    <tr>
                        <td>
                            <div class="admin-recipe-cell">
                                <img src="@imagePath"
                                     alt="@item.Title"
                                     class="admin-recipe-thumb"
                                     onerror="this.src='@fallbackImage'" />
                                <div>
                                    <div class="admin-recipe-name">@item.Title</div>
                                    <div class="admin-recipe-time">⏱ @item.CookTime phút</div>
                                </div>
                            </div>
                        </td>
                        <td>@item.CategoryName</td>
                        <td>@item.AuthorName</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.Status == "Đã duyệt")
                            {
                                <span class="admin-status admin-status-approved">Đã duyệt</span>
                            }
                            else if (item.Status == "Chờ duyệt")
                            {
                                <span class="admin-status admin-status-pending">Chờ duyệt</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status-hidden">Đã ẩn</span>
                            }
                        </td>
                        <td class="admin-action-col">
                            <div class="admin-row-actions">
                                @if (item.Status != "Đã duyệt")
                                {
                                    using (Html.BeginForm("Approve", "Dashboard", new { area = "Admin", id = item.RecipeId }, FormMethod.Post, new { @class = "admin-inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-btn admin-btn-approve">
                                            @(item.Status == "Đã ẩn" ? "Duyệt lại" : "Duyệt")
                                        </button>
                                    }
                                }

                                @if (item.Status != "Đã ẩn")
                                {
                                    using (Html.BeginForm("Hide", "Dashboard", new { area = "Admin", id = item.RecipeId }, FormMethod.Post, new { @class = "admin-inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="admin-btn admin-btn-hide" onclick="return confirm('Bạn có chắc muốn ẩn món này?');">Ẩn</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
