@model CookingBaby.Models.SignUpViewModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-page">
    <div class="auth-card">
        <div style="text-align: center; margin-bottom: 12px;">
            <span style="font-size: 36px;">👩‍🍳</span>
        </div>
        <h2>Đăng Ký Tài Khoản</h2>
        <p class="auth-subtitle">Gia nhập cộng đồng đầu bếp nhí để chia sẻ và lưu giữ công thức yêu thích!</p>
        @using (Html.BeginForm("SignUp", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="auth-field">
                @Html.LabelFor(m => m.FullName, "Họ và tên")
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control-modern", placeholder = "Ví dụ: Nguyễn Văn A", maxlength = "100" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>
            <div class="auth-field">
                @Html.LabelFor(m => m.UserName, "Tên đăng nhập")
                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control-modern", placeholder = "Tên tài khoản viết liền không dấu", maxlength = "50", autocomplete = "username" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
            </div>
            <div class="auth-field">
                @Html.LabelFor(m => m.Email, "Địa chỉ Email")
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control-modern", placeholder = "name@example.com", type = "email", maxlength = "150", autocomplete = "email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>
            <div class="auth-field">
                @Html.LabelFor(m => m.Password, "Mật khẩu")
                @Html.PasswordFor(m => m.Password, new { @class = "form-control-modern", autocomplete = "new-password", placeholder = "Mật khẩu từ 6 ký tự trở lên", minlength = "6" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>
            <div class="auth-field">
                @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu")
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control-modern", autocomplete = "new-password", placeholder = "Nhập lại mật khẩu phía trên", minlength = "6" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>
            <button type="submit" class="btn-brand auth-submit">Đăng ký</button>
        }
        <p class="auth-bottom-link">Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></p>
    </div>
</div>
