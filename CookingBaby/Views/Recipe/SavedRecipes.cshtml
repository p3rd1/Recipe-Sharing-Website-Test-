@model IEnumerable<CookingBaby.Models.RecipeCardViewModel>
@{
    ViewBag.Title = "Công Thức Yêu Thích Đã Lưu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- THÊM TOKEN BẢO MẬT TẠI ĐÂY -->
<div id="ajaxAntiForgery" class="display-none">
    @Html.AntiForgeryToken()
</div>

<div class="saved-header">
    <span class="saved-sub-badge">SỔ TAY LƯU TRỮ</span>
    <h1 class="saved-title">
        Công Thức Yêu Thích Đã Lưu <span class="heart-icon">♥</span>
    </h1>
    <p class="saved-desc">
        Danh sách các công thức món ngon bạn đã đánh dấu để tiện nấu cho bé và gia đình vào dịp cuối tuần.
    </p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="admin-alert admin-alert-error">
        ⚠️ @TempData["ErrorMessage"]
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="recipe-grid" id="savedRecipeGrid">
        @foreach (var item in Model)
        {
            string imgUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                ? Url.Content("~/Content/images/pancake.jpg")
                : (item.ImageUrl.StartsWith("/") || item.ImageUrl.StartsWith("~"))
                    ? Url.Content(item.ImageUrl)
                    : (item.ImageUrl.StartsWith("Uploads/"))
                        ? Url.Content("~/" + item.ImageUrl)
                        : Url.Content("~/Content/images/" + item.ImageUrl);

            <div class="saved-card" id="recipe-card-@item.RecipeId" onclick="openDetailModal(@item.RecipeId)">
                <div class="saved-thumb-wrap">
                    <img src="@imgUrl" alt="@item.Title" onerror="this.src='https://placehold.co/400x250?text=Food'" />
                    <span class="saved-time-badge">⏱ @item.CookTime phút</span>

                    <button type="button" class="btn-heart-unsave"
                            data-recipe-id="@item.RecipeId"
                            data-url="@Url.Action("ToggleSaved", "Home", new { area = "" })"
                            onclick="event.stopPropagation(); handleUnsave(@item.RecipeId, '@Url.Action("ToggleSaved", "Home", new { area = "" })');"
                            title="Bỏ lưu khỏi sổ tay">
                        ♥
                    </button>
                </div>

                <div class="saved-content">
                    <div class="saved-meta-row">
                        <span class="cat-label">@(string.IsNullOrEmpty(item.CategoryName) ? "Món ngon" : item.CategoryName)</span>
                        @if (item.RatingCount > 0 && item.AvgRating.HasValue)
                        {
                            <span class="saved-rating">★ @item.AvgRating.Value.ToString("0.0") (@item.RatingCount)</span>
                        }
                        else
                        {
                            <span class="card-rating-new">☆ Mới (0)</span>
                        }
                    </div>

                    <div class="saved-recipe-name" title="@item.Title">
                        @item.Title
                    </div>
                    <p class="saved-recipe-desc">
                        @item.Description
                    </p>

                    <!-- HIỂN THỊ ĐẦY ĐỦ TAG NGUYÊN LIỆU THẬT TỪ CƠ SỞ DỮ LIỆU -->
                    <div class="recipe-tags-wrap">
                        @if (!string.IsNullOrWhiteSpace(item.Ingredients))
                        {
                            var savedIngs = item.Ingredients.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                                .Select(x => x.Trim())
                                .Where(x => !string.IsNullOrWhiteSpace(x));
                            foreach (var ing in savedIngs)
                            {
                                <span class="recipe-tag-pill">@ing</span>
                            }
                        }
                    </div>

                    <!-- HIỂN THỊ TÊN ĐẦU BẾP ĐỘNG Ở ĐÁY THẺ (CARD FOOTER) -->
                    <div class="card-author-footer">
                        <span>
                            Đầu bếp: <strong class="card-author-name">@item.AuthorName</strong>
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div id="savedEmptyBox" class="saved-empty-box">
        <div class="saved-empty-icon">📖</div>
        <h3 class="saved-empty-title">Sổ tay của bạn đang trống</h3>
        <p class="saved-empty-desc">Bạn chưa lưu công thức nào. Hãy khám phá và bấm biểu tượng ♥ để lưu lại món ăn yêu thích nhé!</p>
        <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn-create-recipe">
            Khám Phá Công Thức Ngay
        </a>
    </div>
}