@model CookingBaby.Models.Recipe
@{
    ViewBag.Title = "Chỉnh Sửa Công Thức";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string currentImgUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? Url.Content("~/Content/images/pancake.jpg")
        : (Model.ImageUrl.StartsWith("/") || Model.ImageUrl.StartsWith("~"))
            ? Url.Content(Model.ImageUrl)
            : (Model.ImageUrl.StartsWith("Uploads/"))
                ? Url.Content("~/" + Model.ImageUrl)
                : Url.Content("~/Content/images/" + Model.ImageUrl);
}

<div class="admin-card edit-recipe-card">
    <!-- Nút [X] quay về Quản Lý Cá Nhân -->
    <a href="@Url.Action("MyRecipes", "Recipe", new { area = "" })"
       class="modal-close-btn"
       title="Đóng / Quay lại">✕</a>

    <div class="edit-recipe-header">
        <h2 class="admin-card-title">Chỉnh Sửa Công Thức</h2>
        <p class="admin-card-subtitle">Cập nhật thông tin công thức món ăn của bạn (nguyên liệu, các bước và hình ảnh)</p>
    </div>

    @using (Html.BeginForm("EditRecipe", "Recipe", FormMethod.Post, new { enctype = "multipart/form-data", id = "editRecipeForm", onsubmit = "return validateEditForm();" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.RecipeId)

        if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(true, "", new { @class = "admin-alert admin-alert-error" })
        }

        <div id="editClientError" class="admin-alert admin-alert-error client-error-box" style="display:none;"></div>

        <div class="form-grid-2-1">
            <div class="form-group-custom">
                <label class="form-label-custom">Tên món ăn <span class="required-star">*</span></label>
                @Html.TextBoxFor(model => model.Title, new { @class = "form-input-custom", id = "editTitle", maxlength = "200", placeholder = "Nhập tên món ăn...", required = "required" })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>
            <div class="form-group-custom">
                <label class="form-label-custom">Thời gian nấu (phút) <span class="required-star">*</span></label>
                @Html.TextBoxFor(model => model.CookTime, new { @class = "form-input-custom", id = "editCookTime", type = "number", min = "1", max = "1440", required = "required" })
                @Html.ValidationMessageFor(model => model.CookTime, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-grid-2">
            <div class="form-group-custom">
                <label class="form-label-custom">Danh mục ẩm thực <span class="required-star">*</span></label>
                @Html.DropDownList("CategoryId", null, htmlAttributes: new { @class = "form-input-custom", required = "required" })
            </div>
            <div class="form-group-custom">
                <label class="form-label-custom">Đổi ảnh đại diện (.jpg, .png, .webp)</label>
                <input type="file" name="ImageFile" id="editImageFile" class="form-input-custom" accept=".jpg,.jpeg,.png,.webp" onchange="previewSelectedImage(this, 'editImagePreview')" />
            </div>
        </div>

        <!-- Khung Preview Ảnh Trực Quan -->
        <div class="preview-image-box">
            <img id="editImagePreview" src="@currentImgUrl" alt="Preview ảnh"
                 class="preview-image-thumb"
                 onerror="this.src='https://placehold.co/400x300?text=Mon+An'" />
            <div>
                <strong class="preview-title">Ảnh hiện tại / Xem trước</strong>
                <small class="preview-hint">Nếu chọn file mới, ảnh sẽ được đổi tên bằng mã Guid an toàn và lưu vào thư mục <code>/Uploads/Recipes/</code> trên Server.</small>
            </div>
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Mô tả ngắn món ăn <span class="required-star">*</span></label>
            @Html.TextAreaFor(model => model.Description, new { @class = "form-input-custom", id = "editDescription", rows = "2", maxlength = "500", placeholder = "Mô tả hương vị hấp dẫn của món ăn...", required = "required" })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Nguyên liệu (Cách nhau bằng dấu phẩy) <span class="required-star">*</span></label>
            <input type="text" name="IngredientsList" id="editIngredients" class="form-input-custom" value="@ViewBag.IngredientsString" placeholder="VD: Trứng gà, Bơ lạt, Sữa tươi" required />
            @if (ViewBag.IngredientsError != null)
            {
                <span class="text-danger">@ViewBag.IngredientsError</span>
            }
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Các bước thực hiện (Mỗi bước 1 dòng) <span class="required-star">*</span></label>
            <textarea name="Instructions" id="editInstructions" class="form-input-custom" rows="5" placeholder="Sơ chế sạch nguyên liệu.&#10;Nấu chín vừa tới.&#10;Trình bày ra đĩa thưởng thức." required>@ViewBag.InstructionsString</textarea>
            @if (ViewBag.InstructionsError != null)
            {
                <span class="text-danger">@ViewBag.InstructionsError</span>
            }
        </div>

        <div class="form-actions-custom">
            <button type="submit" class="btn-submit-custom">Lưu Thay Đổi</button>
            <a href="@Url.Action("MyRecipes", "Recipe", new { area = "" })" class="btn-cancel-custom">Hủy bỏ</a>
        </div>
    }
</div>
