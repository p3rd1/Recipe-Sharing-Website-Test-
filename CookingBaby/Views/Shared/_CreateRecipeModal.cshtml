@* Views/Shared/_CreateRecipeModal.cshtml *@
<div id="createRecipeModal" class="modal-overlay">
    <div class="modal-window">
        <button type="button" class="modal-close-btn" onclick="closeCreateModal()">✕</button>

        <h3 class="modal-header-title">Đăng Chia Sẻ Công Thức Mới</h3>
        <p class="modal-header-desc">Công thức của bạn sẽ được gửi tới Ban Quản Trị duyệt trước khi công khai</p>
        <hr class="modal-divider" />

        @using (Html.BeginForm("CreateRecipe", "Recipe", FormMethod.Post, new { enctype = "multipart/form-data", id = "createRecipeForm", onsubmit = "return validateCreateModalForm();" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group-custom">
                <label class="form-label-custom">Tên món ăn <span class="required-star">*</span></label>
                <input type="text" name="Title" id="createTitle" required class="form-input-custom" placeholder="Ví dụ: Bánh Mì Nướng Bơ Tỏi" />
            </div>

            <div class="form-grid-2">
                <div class="form-group-custom">
                    <label class="form-label-custom">Danh mục Đầu Bếp Nhí <span class="required-star">*</span></label>
                    @{
                        List<SelectListItem> modalCategoryOptions;
                        using (var modalDb = new CookingBaby.Models.CookingBabyDBEntities())
                        {
                            modalCategoryOptions = modalDb.Categories
                                .OrderBy(c => c.DisplayOrder)
                                .Select(c => new SelectListItem { Value = c.CategoryId.ToString(), Text = c.CategoryName })
                                .ToList();
                        }
                    }
                    @Html.DropDownList("CategoryId", modalCategoryOptions, new { @class = "form-input-custom", required = "required" })
                </div>
                <div class="form-group-custom">
                    <label class="form-label-custom">Thời gian nấu (phút) <span class="required-star">*</span></label>
                    <input type="number" name="CookTime" id="createCookTime" value="15" min="1" max="1440" required class="form-input-custom" />
                </div>
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Hình ảnh đại diện (.jpg, .png, .webp)</label>
                <input type="file" name="ImageFile" id="createImageFile" accept=".jpg,.jpeg,.png,.webp" class="form-input-custom" onchange="previewCreateModalImage(this)" />
                <div id="createPreviewBox" class="preview-image-box display-none">
                    <img id="createImagePreview" src="" alt="Xem trước" class="preview-image-thumb" />
                    <div>
                        <span class="preview-title">Xem trước ảnh món ăn</span>
                        <small class="preview-hint">Ảnh sẽ được lưu tự động vào thư mục an toàn trên server.</small>
                    </div>
                </div>
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Mô tả ngắn món ăn</label>
                <textarea name="Description" id="createDesc" rows="2" class="form-input-custom" placeholder="Món ăn giòn rụm, thơm lừng bơ tỏi..."></textarea>
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Nguyên liệu (cách nhau bằng dấu phẩy) <span class="required-star">*</span></label>
                <input type="text" name="IngredientsList" id="createIngredients" class="form-input-custom" placeholder="Bánh mì, Bơ lạt, Tỏi băm, Mùi tây" required />
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Các bước thực hiện (Mỗi bước 1 dòng) <span class="required-star">*</span></label>
                <textarea name="Instructions"
                          id="createInstructions"
                          class="form-input-custom"
                          rows="3"
                          placeholder="Sơ chế sạch nguyên liệu.&#10;Nấu chín vừa tới.&#10;Trình bày ra đĩa thưởng thức."
                          required></textarea>
            </div>

            <div class="form-actions-custom">
                <button type="submit" class="btn-submit-custom">Gửi Duyệt Công Thức</button>
                <button type="button" class="btn-cancel-custom" onclick="closeCreateModal()">Hủy bỏ</button>
            </div>
        }
    </div>
</div>
