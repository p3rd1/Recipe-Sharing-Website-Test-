@{
    bool isAdminPage = (ViewBag.IsAdminPage as bool?) == true;
    bool isLoggedIn = Request.IsAuthenticated && Session["UserID"] is int;
    bool isAdmin = isLoggedIn && (Session["Role"] as string) == "Admin";
    string roleLabel = !isLoggedIn ? "Khách" : (isAdmin ? "Quản trị viên (Admin)" : "Thành viên đăng bài");
    int myRecipeCount = 0;
    int savedCount = 0;
    int pendingAdminCount = 0;

    if (isLoggedIn)
    {
        try
        {
            using (var dbContext = new CookingBaby.Models.CookingBabyDBEntities())
            {
                int currentUserId = (int)Session["UserID"];
                myRecipeCount = dbContext.Recipes.Count(r => r.AuthorId == currentUserId && r.Status != "Đã ẩn");
                savedCount = dbContext.SavedRecipes.Count(r => r.UserId == currentUserId);
                if (isAdmin)
                {
                    pendingAdminCount = dbContext.Recipes.Count(r => r.Status == "Chờ duyệt");
                }
            }
        }
        catch
        {
            // Không để lỗi thống kê ở header che mất thông báo lỗi chính của trang.
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Cooking Baby</title>
    <link href="~/Content/cookingbaby.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tabs = document.querySelectorAll(".nav-tab-item");
            var currentPath = window.location.pathname.toLowerCase();

            tabs.forEach(function (tab) {
                tab.classList.remove("active");
            });

            tabs.forEach(function (tab) {
                var tabPath = new URL(tab.href).pathname.toLowerCase();

                if (
                    (currentPath === "/" || currentPath === "/home" || currentPath === "/home/index")
                    &&
                    (tabPath === "/" || tabPath === "/home" || tabPath === "/home/index")
                ) {
                    tab.classList.add("active");
                }
                else if (currentPath === tabPath) {
                    tab.classList.add("active");
                }
            });
        });
    </script>
</head>
<body>
    <!-- Hiển thị vai trò thực tế của phiên, không phải các liên kết demo giả lập -->
    <div class="demo-topbar">
        <div class="container topbar-flex">
            <span class="tag-alert">COOKING BABY</span>
            <div class="role-selector"><span class="active-role">Vai trò: @roleLabel</span></div>
        </div>
    </div>

    <!-- Header chính -->
    <header class="main-header">
        <div class="container header-flex">
            <!-- Khung Logo bên trái -->
            <a class="brand-pill" href="@Url.Action("Index", "Home", new { area = "" })">
                <img src="~/Content/images/logo.jpg" alt="Logo" class="logo-img" onerror="this.src='https://placehold.co/48?text=CB'" />
                <div class="brand-text">
                    <span class="sub">RECIPE COMMUNITY</span>
                    <span class="main">Bếp Vui Mỗi Ngày</span>
                </div>
            </a>

            <!-- Cụm Tab Menu -->
            <nav class="nav-tab-group">
                <!-- 1. Khám phá công thức -->
                <a href="@Url.Action("Index", "Home", new { area = "" })"
                   class="nav-tab-item @(ViewBag.ActiveTab != "MyRecipes" && ViewBag.ActiveTab != "SavedRecipes" && ViewBag.ActiveTab != "Admin" ? "active" : "")">
                    Khám Phá Công Thức
                </a>

                @if (isLoggedIn)
                {
                    <!-- Thành viên / Admin: các chức năng cá nhân -->
                    <a href="@Url.Action("MyRecipes", "Recipe", new { area = "" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "MyRecipes" ? "active" : "")">
                        Quản Lý Cá Nhân <span class="nav-badge">@myRecipeCount</span>
                    </a>
                    <a href="@Url.Action("SavedRecipes", "Recipe", new { area = "" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "SavedRecipes" ? "active" : "")">
                        Đã Lưu <span class="nav-badge">@savedCount</span>
                    </a>
                }
                @if (isAdmin)
                {
                    @Html.ActionLink("Quản Lý Danh Mục", "Index", "Categories", new { area = "" }, new { @class = "nav-tab-item" })
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "Admin" ? "active" : "")">
                        Duyệt Bài (Admin) <span class="nav-badge">@pendingAdminCount</span>
                    </a>
                }

            </nav>

            <!-- Nút bên phải Header (Đã tích hợp Đăng nhập / Đăng xuất) -->
            <div style="display: flex; align-items: center; gap: 12px;">
                @if (isLoggedIn && !isAdminPage)
                {
                    <a href="javascript:void(0)" onclick="openCreateModal()" class="btn-create-recipe">
                        + Đăng Công Thức
                    </a>
                }
                else if (isAdminPage)
                {
                    <span class="admin-header-badge">ADMIN CONTROL PANEL</span>
                }

                <!-- Kiểm tra trạng thái đăng nhập từ Session -->
                @{
                    if (!isLoggedIn)
                    {
                        <div class="auth-header-btns">
                            <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn-auth-login">
                                Đăng nhập
                            </a>
                            <a href="@Url.Action("SignUp", "Account", new { area = "" })" class="btn-auth-signup">
                                Đăng ký
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="user-profile-badge">
                            <div class="user-avatar-circle">
                                👨‍🍳
                            </div>
                            <div class="user-info-text">
                                <span class="user-hello-label">Xin chào,</span>
                                <strong class="user-name-title">@Session["FullName"]</strong>
                            </div>

                            @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", style = "margin: 0;" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-user-logout" title="Đăng xuất khỏi hệ thống">
                                    Đăng xuất
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </header>

    <!-- Thân trang -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer chuẩn theo ảnh -->
    <footer class="site-footer">
        <div class="container footer-flex">
            <div class="footer-left">
                <img src="~/Content/images/logo.jpg" alt="Cooking Baby" class="footer-logo" onerror="this.src='https://placehold.co/32?text=CB'" />
                <span>— Đồ án Website Chia Sẻ Công Thức Nấu Ăn (Siêu đầu bếp nhí)</span>
            </div>
            <div class="footer-right">
                Nghiệp vụ: Recipe/Category/Ingredient • Đánh giá TB • Phân quyền Chủ sở hữu • Admin Duyệt/Ẩn
            </div>
        </div>
    </footer>

    <!-- NHÚNG MODAL ĐĂNG CÔNG THỨC VÀO LAYOUT ĐỂ TRÁNH LỖI NULL -->
    @Html.Partial("_RecipeDetailModal")
    @if (isLoggedIn)
    {
        @Html.Partial("_CreateRecipeModal")
        <div id="ajaxAntiForgery" style="display:none">@Html.AntiForgeryToken()</div>
    }

    <!-- Nhúng file Script điều khiển -->
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/cookingbaby.js"></script>

    <!-- SCRIPT ĐIỀU KHIỂN MODAL (ĐÃ SỬA LỖI CHỒNG CHÉO) -->
    <script>
        // openCreateModal & closeCreateModal đã khai báo trong cookingbaby.js
        // Ở đây chỉ bổ sung: đóng bằng ESC, click overlay, nút Hủy

        document.addEventListener('click', function (e) {
            // Đóng modal Tạo công thức khi click đúng vào overlay
            var createModal = document.getElementById('createRecipeModal');
            if (createModal && e.target === createModal) {
                closeCreateModal();
            }
            // Đóng modal Chi tiết khi click đúng vào overlay
            var detailModal = document.getElementById('recipeDetailModal');
            if (detailModal && e.target === detailModal) {
                closeDetailModal();
            }
            // Nút Hủy bỏ trong form tạo công thức
            if (e.target && e.target.classList.contains('btn-cancel-custom')) {
                closeCreateModal();
            }
        });

        // Nhấn ESC đóng cả 2 modal
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeCreateModal();
                if (typeof closeDetailModal === 'function') closeDetailModal();
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>