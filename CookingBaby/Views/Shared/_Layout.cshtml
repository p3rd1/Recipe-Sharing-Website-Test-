@{
    int currentUid = Session["UserID"] is int id ? id : 0;
    bool isLoggedIn = currentUid > 0;
    string userRole = (Session["Role"] as string) ?? "";
    bool isAdmin = isLoggedIn && userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
    bool isRegularUser = isLoggedIn && !isAdmin;
    bool isAdminPage = (ViewBag.IsAdminPage as bool?) == true || isAdmin;
    string roleLabel = !isLoggedIn ? "Khách" : (isAdmin ? "Quản trị viên (Admin)" : "Thành viên đăng bài");
    int myRecipeCount = 0;
    int savedCount = 0;
    int pendingAdminCount = 0;

    if (isLoggedIn)
    {
        try
        {
            using (var dbContext = new CookingBaby.Models.CookingBabyDBEntities())
            {
                if (isRegularUser)
                {
                    myRecipeCount = dbContext.Recipes.Count(r => r.AuthorId == currentUid && r.Status != "Đã ẩn");
                    savedCount = dbContext.SavedRecipes.Count(r => r.UserId == currentUid);
                }
                else if (isAdmin)
                {
                    pendingAdminCount = dbContext.Recipes.Count(r => r.Status == "Chờ duyệt");
                }
            }
        }
        catch
        {
            // Không để lỗi thống kê ở header che mất thông báo lỗi chính của trang.
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Cooking Baby</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="~/Content/cookingbaby.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
</head>
<body>
    <!-- Hiển thị vai trò thực tế của phiên, không phải các liên kết demo giả lập -->
    <div class="demo-topbar">
        <div class="container topbar-flex">
            <span class="tag-alert">COOKING BABY</span>
            <div class="role-selector"><span class="active-role">Vai trò: @roleLabel</span></div>
        </div>
    </div>

    <!-- Header chính -->
    <header class="main-header">
        <div class="container header-flex">
            <!-- Khung Logo bên trái -->
            <a class="brand-pill" href="@Url.Action("Index", "Home", new { area = "" })">
                <img src="~/Content/images/logo.jpg" alt="Logo" class="logo-img" onerror="this.src='https://placehold.co/48?text=CB'" />
                <div class="brand-text">
                    <span class="sub">RECIPE COMMUNITY</span>
                    <span class="main">Bếp Vui Mỗi Ngày</span>
                </div>
            </a>

            <!-- Cụm Tab Menu: TÁCH BIỆT RÕ RÀNG GIỮA ADMIN VÀ USER -->
            <nav class="nav-tab-group">
                <!-- 1. Khám phá công thức: Tất cả mọi người đều có thể duyệt xem -->
                <a href="@Url.Action("Index", "Home", new { area = "" })"
                   class="nav-tab-item @(ViewBag.ActiveTab != "MyRecipes" && ViewBag.ActiveTab != "SavedRecipes" && ViewBag.ActiveTab != "Admin" && ViewBag.ActiveTab != "Categories" && ViewBag.ActiveTab != "Users" ? "active" : "")">
                    Khám Phá Công Thức
                </a>

                @if (isRegularUser)
                {
                    <!-- MENU DÀNH RIÊNG CHO THÀNH VIÊN THƯỜNG -->
                    <a href="@Url.Action("MyRecipes", "Recipe", new { area = "" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "MyRecipes" ? "active" : "")">
                        Quản Lý Cá Nhân <span class="nav-badge">@myRecipeCount</span>
                    </a>
                    <a href="@Url.Action("SavedRecipes", "Recipe", new { area = "" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "SavedRecipes" ? "active" : "")">
                        Đã Lưu <span class="nav-badge">@savedCount</span>
                    </a>
                }
                else if (isAdmin)
                {
                    <!-- MENU DÀNH RIÊNG CHO QUẢN TRỊ VIÊN (ADMIN) -->
                    <a href="@Url.Action("Index", "Categories", new { area = "" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "Categories" ? "active" : "")">
                        Quản Lý Danh Mục
                    </a>
                    <a href="@Url.Action("Index", "Users", new { area = "Admin" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "Users" ? "active" : "")">
                        Quản Lý Tài Khoản
                    </a>
                    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"
                       class="nav-tab-item @(ViewBag.ActiveTab == "Admin" ? "active" : "")">
                        Duyệt Bài (Admin) <span class="nav-badge">@pendingAdminCount</span>
                    </a>
                }
            </nav>

            <!-- Nút bên phải Header (Đã tích hợp Đăng nhập / Đăng xuất) -->
            <div class="header-right-actions">
                @if (isRegularUser)
                {
                    <!-- Chỉ Thành viên thường mới có nút + Đăng Công Thức -->
                    <a href="javascript:void(0)" onclick="openCreateModal()" class="btn-create-recipe">
                        + Đăng Công Thức
                    </a>
                }
                else if (isAdmin)
                {
                    <!-- Admin hiển thị huy hiệu quản trị, không có nút Đăng Công Thức -->
                    <span class="admin-header-badge">ADMIN CONTROL PANEL</span>
                }

                <!-- Kiểm tra trạng thái đăng nhập từ Session -->
                @{
                    if (!isLoggedIn)
                    {
                        <div class="auth-header-btns">
                            <a href="@Url.Action("Login", "Account", new { area = "" })" class="btn-auth-login">
                                Đăng nhập
                            </a>
                            <a href="@Url.Action("SignUp", "Account", new { area = "" })" class="btn-auth-signup">
                                Đăng ký
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="user-profile-badge-wrap">
                            <div class="user-profile-badge" title="Tài khoản đang đăng nhập">
                                <div class="user-avatar-circle">
                                    👨‍🍳
                                </div>
                                <div class="user-info-text">
                                    <span class="user-hello-label">Xin chào,</span>
                                    <strong class="user-name-title">@(Session["DisplayName"] ?? Session["FullName"])</strong>
                                </div>
                            </div>

                            @using (Html.BeginForm("Logout", "Account", new { area = "" }, FormMethod.Post, new { id = "logoutForm", @class = "user-logout-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-user-logout" title="Đăng xuất khỏi hệ thống">
                                    Đăng xuất
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </header>

    <!-- Thân trang -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer chuẩn theo ảnh -->
    <footer class="site-footer">
        <div class="container footer-flex">
            <div class="footer-left">
                <img src="~/Content/images/logo.jpg" alt="Cooking Baby" class="footer-logo" onerror="this.src='https://placehold.co/32?text=CB'" />
                <span>— Đồ án Website Chia Sẻ Công Thức Nấu Ăn (Siêu đầu bếp nhí)</span>
            </div>
            <div class="footer-right">
                Nghiệp vụ: Recipe/Category/Ingredient • Đánh giá TB • Phân quyền Chủ sở hữu • Admin Duyệt/Ẩn
            </div>
        </div>
    </footer>

    <!-- NHÚNG MODAL ĐĂNG CÔNG THỨC VÀO LAYOUT ĐỂ TRÁNH LỖI NULL -->
    @Html.Partial("_RecipeDetailModal")
    @if (isLoggedIn)
    {
        @Html.Partial("_CreateRecipeModal")
        <div id="ajaxAntiForgery" class="display-none">@Html.AntiForgeryToken()</div>
    }

    <!-- Nhúng file Script điều khiển ở cuối thẻ body -->
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    @if (ViewBag.IsAdminPage == true || ViewBag.ActiveTab == "Admin")
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    }
    <script src="~/Scripts/cookingbaby.js?v=@DateTime.Now.Ticks"></script>

    @RenderSection("scripts", required: false)
</body>
</html>