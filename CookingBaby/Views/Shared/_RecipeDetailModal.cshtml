@* Views/Shared/_RecipeDetailModal.cshtml *@
<div id="recipeDetailModal" class="modal-overlay">
    <div class="modal-window modal-window-detail">
        <!-- Nút X đóng Modal -->
        <button type="button" class="modal-close-btn" onclick="closeDetailModal()">✕</button>

        <!-- 1. Tag phân loại trên cùng -->
        <div class="modal-cat-tag-wrap">
            <span id="modalDetailCat" class="modal-cat-tag">
                Healthy & Rau Củ
            </span>
        </div>

        <!-- 2. Header chi tiết: Ảnh lớn bên trái + Thông tin & Điểm TB bên phải -->
        <div class="modal-detail-grid">
            <!-- Khung ảnh có badge thời gian -->
            <div class="modal-img-wrap">
                <img id="modalDetailImg" src="" alt="Món ăn" onerror="this.src='https://placehold.co/400x300?text=Mon+An'" />
                <span id="modalDetailTime" class="modal-time-badge">
                    ⏱ 20 phút
                </span>
            </div>

            <!-- Cột thông tin món -->
            <div>
                <h2 id="modalDetailTitle" class="modal-recipe-title">
                    Tên món ăn
                </h2>
                <p id="modalDetailDesc" class="modal-recipe-desc">
                    Mô tả món ăn tóm tắt...
                </p>

                <!-- Box Điểm đánh giá trung bình & Tác giả -->
                <div class="modal-rating-author-box">
                    <div class="rating-group-inline">
                        <span id="modalDetailRatingScore" class="modal-rating-score-badge">
                            5.0
                        </span>
                        <div>
                            <div class="modal-stars-gold">★★★★★</div>
                            <small id="modalDetailReviewCount" class="modal-review-count">Điểm trung bình từ 1 đánh giá</small>
                        </div>
                    </div>
                    <div class="author-meta-box">
                        <small class="modal-author-label">Đầu bếp chia sẻ:</small>
                        <strong id="modalDetailAuthor" class="modal-author-name">Đang tải...</strong>
                    </div>
                </div>

                <!-- Nút lưu & Ghi chú quyền tác giả -->
                <div class="modal-actions-bar">
                    @if (Request.IsAuthenticated && Session["UserID"] is int)
                    {
                        <button type="button" id="modalToggleSaveBtn" class="btn-create-recipe modal-save-btn"
                                onclick="toggleSavedFromModal()">♡ Lưu vào sổ tay</button>
                    }
                    else
                    {
                        <a class="btn-create-recipe modal-save-btn" href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập để lưu</a>
                    }

                    <!-- Khu vực phân quyền: Thông báo hoặc Nút Sửa/Xóa của tác giả -->
                    <div>
                        <small id="modalAuthorPermission" class="author-permission-note">Chỉ tác giả mới có quyền sửa/xóa</small>
                        <div id="modalAuthorActions" class="modal-author-actions">
                            <a id="modalEditBtn" href="#" class="btn-pill-action btn-pill-edit">✏ Sửa</a>
                            @using (Html.BeginForm("DeleteMyRecipe", "Recipe", new { area = "" }, FormMethod.Post, new { id = "modalDeleteForm", @class = "admin-inline-form", onsubmit = "return confirm('Bạn chắc chắn muốn xóa công thức này?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="modalDeleteId" />
                                <button type="submit" id="modalDeleteBtn" class="btn-pill-action btn-pill-del">🗑 Xóa</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="site-divider" />

        <!-- 3. Khu vực 2 cột: Nguyên liệu (Checklist) + Các bước thực hiện -->
        <div class="modal-columns-2">
            <!-- Cột trái: Nguyên liệu cần chuẩn bị -->
            <div>
                <div class="detail-header-flex">
                    <h4 class="detail-section-title">🥣 Nguyên liệu cần chuẩn bị</h4>
                    <small class="muted-note">Tick để đánh dấu</small>
                </div>

                <div id="modalDetailIngredients" class="detail-column-stack">
                    <p class="muted-desc">Đang tải nguyên liệu...</p>
                </div>
            </div>

            <!-- Cột phải: Các bước thực hiện đánh số tròn -->
            <div>
                <h4 class="detail-section-title">🍳 Các bước thực hiện</h4>

                <div id="modalDetailSteps" class="detail-column-stack">
                    <p class="muted-desc">Đang tải các bước...</p>
                </div>
            </div>
        </div>

        <hr class="site-divider" />

        <!-- 4. Đánh giá & Bình luận từ cộng đồng -->
        <div class="review-section">
            <h4 class="review-section-title">
                ⭐ Đánh giá & Bình luận từ cộng đồng
            </h4>

            <input type="hidden" id="reviewRecipeId" value="" />
            <input type="hidden" id="selectedRating" name="Rating" value="0" />

            @if (Session["UserID"] != null)
            {
                <!-- Chọn số sao kèm nhãn đánh giá -->
                <div class="rating-select-bar">
                    <span class="rating-select-label">Chọn số sao của bạn:</span>
                    <div class="rating-stars" id="starRatingBox">
                        <span class="rating-star" data-value="1" data-val="1" title="1 sao - Rất tệ">★</span>
                        <span class="rating-star" data-value="2" data-val="2" title="2 sao - Chưa tốt">★</span>
                        <span class="rating-star" data-value="3" data-val="3" title="3 sao - Bình thường">★</span>
                        <span class="rating-star" data-value="4" data-val="4" title="4 sao - Tốt">★</span>
                        <span class="rating-star" data-value="5" data-val="5" title="5 sao - Tuyệt vời">★</span>
                    </div>
                    <span id="starRatingLabel" class="star-rating-label">(Chưa chọn sao)</span>
                </div>
    
                <!-- Ô nhập bình luận + Nút gửi -->
                <div class="review-input-bar">
                    <input type="text"
                           id="reviewContent"
                           name="Content"
                           class="form-input-custom"
                           placeholder="Chia sẻ cảm nhận của bạn sau khi nấu thử..." />
    
                    <button type="button"
                            id="btnSubmitReview"
                            class="btn-submit-review"
                            onclick="submitReview()">
                        Gửi Đánh Giá
                    </button>
                </div>
            }
            else
            {
                <p class="auth-bottom-link"><a href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập</a> để đánh giá hoặc bình luận công thức.</p>
            }

            <!-- Danh sách các bài đánh giá trước đó -->
            <div class="review-list-section">
                <div id="reviewList">
                    <p class="muted-desc">Đang tải bình luận...</p>
                </div>
            </div>
        </div>

    </div>
</div>