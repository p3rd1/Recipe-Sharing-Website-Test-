@* Views/Shared/_RecipeDetailModal.cshtml *@
<div id="recipeDetailModal" class="modal-overlay">
    <div class="modal-window" style="max-width: 820px; padding: 28px 32px;">
        <!-- Nút X đóng Modal -->
        <button type="button" class="modal-close-btn" onclick="closeDetailModal()">✕</button>
        <!-- 1. Tag phân loại trên cùng -->
        <div style="margin-bottom: 14px;">
            <span id="modalDetailCat" style="background: #F0FDF4; color: #166534; font-size: 11.5px; font-weight: 800; padding: 5px 12px; border-radius: 14px; border: 1px solid #BBF7D0; display: inline-block;">
                Healthy & Rau Củ
            </span>
        </div>

        <!-- 2. Header chi tiết: Ảnh lớn bên trái + Thông tin & Điểm TB bên phải -->
        <div style="display: grid; grid-template-columns: 260px 1fr; gap: 24px; align-items: start; margin-bottom: 24px;">
            <!-- Khung ảnh có badge thời gian -->
            <div style="position: relative; width: 100%; height: 200px; border-radius: 20px; overflow: hidden; background: #EDF2F7; border: 1px solid var(--line);">
                <img id="modalDetailImg" src="" alt="Món ăn" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://placehold.co/400x300?text=Mon+An'" />
                <span id="modalDetailTime" style="position: absolute; top: 12px; left: 12px; background: rgba(255, 255, 255, 0.92); color: #2D3748; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 14px; box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
                    ⏱ 20 phút
                </span>
            </div>

            <!-- Cột thông tin món -->
            <div>
                <h2 id="modalDetailTitle" style="margin: 0 0 6px 0; font-size: 24px; font-weight: 900; color: #2D3748; line-height: 1.3;">
                    Tên món ăn
                </h2>
                <p id="modalDetailDesc" style="font-size: 13px; color: #718096; line-height: 1.5; margin: 0 0 16px 0;">
                    Mô tả món ăn tóm tắt...
                </p>

                <!-- Box Điểm đánh giá trung bình & Tác giả -->
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 10px 14px; border-radius: 12px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span id="modalDetailRatingScore" style="font-size: 20px; font-weight: 900; color: #DD6B20; background: #FFF; border: 1px solid #FBD38D; padding: 2px 8px; border-radius: 8px;">
                            5.0
                        </span>
                        <div>
                            <div style="color: #F6AD55; font-size: 12px; letter-spacing: 1px;">★★★★★</div>
                            <small id="modalDetailReviewCount" style="color: #718096; font-size: 10.5px;">Điểm trung bình từ 1 đánh giá</small>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <small style="color: #A0AEC0; font-size: 10px; display: block;">Đầu bếp chia sẻ:</small>
                        <strong id="modalDetailAuthor" style="font-size: 12.5px; color: #2D3748;">Đang tải...</strong>
                    </div>
                </div>

                <!-- Nút lưu & Ghi chú quyền tác giả -->
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    @if (Request.IsAuthenticated && Session["UserID"] is int)
                    {
                        <button type="button" id="modalToggleSaveBtn" class="btn-create-recipe"
                                style="padding:6px 14px;font-size:12px;cursor:pointer;background:#FF5A1F;border:none;"
                                onclick="toggleSavedFromModal()">♡ Lưu vào sổ tay</button>
                    }
                    else
                    {
                        <a class="btn-create-recipe" style="padding:6px 14px;font-size:12px;text-decoration:none;" href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập để lưu</a>
                    }

                    <!-- Khu vực phân quyền: Thông báo hoặc Nút Sửa/Xóa của tác giả -->
                    <div>
                        <small id="modalAuthorPermission" style="color: #A0AEC0; font-size: 11px;">Chỉ tác giả mới có quyền sửa/xóa</small>
                        <div id="modalAuthorActions" style="display: none; gap: 6px; align-items: center;">
                            <a id="modalEditBtn" href="#" class="btn-pill-action btn-pill-edit" style="padding: 3px 10px; font-size: 11.5px; text-decoration: none;">✏ Sửa</a>
                            @using (Html.BeginForm("DeleteMyRecipe", "Recipe", new { area = "" }, FormMethod.Post, new { id = "modalDeleteForm", style = "display:inline", onsubmit = "return confirm('Bạn chắc chắn muốn xóa công thức này?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" id="modalDeleteId" />
                                <button type="submit" id="modalDeleteBtn" class="btn-pill-action btn-pill-del" style="padding: 3px 10px; font-size: 11.5px;">🗑 Xóa</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--line); margin: 20px 0;" />

        <!-- 3. Khu vực 2 cột: Nguyên liệu (Checklist) + Các bước thực hiện -->
        <div style="display: grid; grid-template-columns: 280px 1fr; gap: 24px; margin-bottom: 24px;">
            <!-- Cột trái: Nguyên liệu cần chuẩn bị -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                    <h4 style="margin: 0; font-size: 14.5px; font-weight: 800; color: #2D3748;">🥣 Nguyên liệu cần chuẩn bị</h4>
                    <small style="color: #A0AEC0; font-size: 10.5px;">Tick để đánh dấu</small>
                </div>

                <div id="modalDetailIngredients" style="display: flex; flex-direction: column; gap: 8px;">
                    <p style="font-size:13px; color:#718096;">Đang tải nguyên liệu...</p>
                </div>
            </div>

            <!-- Cột phải: Các bước thực hiện đánh số tròn -->
            <div>
                <h4 style="margin: 0 0 12px 0; font-size: 14.5px; font-weight: 800; color: #2D3748;">🍳 Các bước thực hiện</h4>

                <div id="modalDetailSteps" style="display: flex; flex-direction: column; gap: 12px;">
                    <p style="font-size:13px; color:#718096;">Đang tải các bước...</p>
                </div>
            </div>
        </div>

        <hr style="border: 0; border-top: 1px solid var(--line); margin: 20px 0;" />

        <!-- 4. Đánh giá & Bình luận từ cộng đồng -->
        <div class="review-section">
            <h4 style="font-size: 15px; margin: 0 0 14px; font-weight: 800; color: #2D3748;">
                ⭐ Đánh giá & Bình luận từ cộng đồng
            </h4>

            <input type="hidden" id="reviewRecipeId" value="" />
            <input type="hidden" id="selectedRating" value="0" />

            @if (Request.IsAuthenticated && Session["UserID"] is int)
            {
                <!-- Chọn số sao kèm nhãn đánh giá -->
                <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 13px; font-weight: 700; color: #4A5568;">Chọn số sao của bạn:</span>
                    <div class="rating-stars" style="font-size: 20px;">
                        <span class="rating-star" data-value="1">★</span>
                        <span class="rating-star" data-value="2">★</span>
                        <span class="rating-star" data-value="3">★</span>
                        <span class="rating-star" data-value="4">★</span>
                        <span class="rating-star" data-value="5">★</span>
                    </div>
                    <span id="starRatingLabel" style="font-size: 12px; font-weight: 700; color: #DD6B20;">(Chưa chọn sao)</span>
                </div>
    
                <!-- Ô nhập bình luận + Nút gửi -->
                <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="text"
                           id="reviewContent"
                           class="form-input-custom"
                           style="margin-bottom: 0;"
                           placeholder="Chia sẻ cảm nhận của bạn sau khi nấu thử..." />
    
                    <button type="button"
                            id="btnSubmitReview"
                            class="btn-create-recipe"
                            style="white-space: nowrap; border: none; cursor: pointer; padding: 10px 20px; font-size: 13px;"
                            onclick="submitReview()">
                        Gửi Đánh Giá
                    </button>
                </div>
            }
            else
            {
                <p class="auth-bottom-link"><a href="@Url.Action("Login", "Account", new { area = "" })">Đăng nhập</a> để đánh giá hoặc bình luận công thức.</p>
            }

            <!-- Danh sách các bài đánh giá trước đó -->
            <div class="review-list-section" style="margin-top: 20px;">
                <div id="reviewList">
                    <p style="font-size: 13px; color: var(--muted);">Đang tải bình luận...</p>
                </div>
            </div>
        </div>

    </div>
</div>