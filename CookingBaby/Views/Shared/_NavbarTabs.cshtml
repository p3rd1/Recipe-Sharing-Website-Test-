@{
    string activeTab = ViewBag.ActiveTab as string;
    int myRecipeCount = ViewBag.MyRecipeCount ?? 0;
    int savedCount = ViewBag.SavedCount ?? 0;
    bool isLoggedIn = Request.IsAuthenticated && Session["UserID"] is int;
    bool isAdmin = isLoggedIn && (Session["Role"] as string) == "Admin";
}

<nav class="nav-tab-group">
    <!-- 1. Trang chủ -->
    <a href="@Url.Action("Index", "Home", new { area = "" })"
       class="nav-tab-item @(activeTab != "MyRecipes" && activeTab != "SavedRecipes" && activeTab != "Admin" ? "active" : "")">
        Khám Phá Công Thức
    </a>
    
    @if (isLoggedIn)
    {
        <a href="@Url.Action("MyRecipes", "Recipe", new { area = "" })" class="nav-tab-item @(activeTab == "MyRecipes" ? "active" : "")">Quản Lý Cá Nhân <span class="nav-badge">@myRecipeCount</span></a>
        <a href="@Url.Action("SavedRecipes", "Recipe", new { area = "" })" class="nav-tab-item @(activeTab == "SavedRecipes" ? "active" : "")">Đã Lưu <span class="nav-badge">@savedCount</span></a>
    }
    @if (isAdmin)
    {
        @Html.ActionLink("Quản Lý Danh Mục", "Index", "Categories", new { area = "" }, new { @class = "nav-tab-item" })
        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })" class="nav-tab-item @(activeTab == "Admin" ? "active" : "")">Duyệt Bài (Admin)</a>
    }

</nav>
